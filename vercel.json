{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/proyectos/:id(ledgercore|fracxion|space-tasks)/?",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/en/projects/:id(fracxion|space-tasks)/?",
      "destination": "/en/#projects",
      "permanent": true
    }
  ]
}
