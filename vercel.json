{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/proyectos/ledgercore",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/proyectos/ledgercore/",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/proyectos/fracxion",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/proyectos/fracxion/",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/proyectos/space-tasks",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/proyectos/space-tasks/",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/en/projects/fracxion",
      "destination": "/en/#projects",
      "permanent": true
    },
    {
      "source": "/en/projects/fracxion/",
      "destination": "/en/#projects",
      "permanent": true
    },
    {
      "source": "/en/projects/space-tasks",
      "destination": "/en/#projects",
      "permanent": true
    },
    {
      "source": "/en/projects/space-tasks/",
      "destination": "/en/#projects",
      "permanent": true
    }
  ]
}
